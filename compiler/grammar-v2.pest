program     = _{ SOI ~ exps ~ EOI }
exps        =  { exp+ }
decls       =  { decl | decl ~ decls }
decl        =  { ident ~ ":" ~ exps }
ident       = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ prime* }
exp         =  { compound | single }
single      =  { scalar | op | primitive | ident }
scalar      =  { duration | frequency | pure }
duration    = ${ fixed | fractional }
fixed       = ${ (minutes | seconds | minutes ~ seconds) }
frequency   = ${ absolute ~ "~" }
minutes     = ${ absolute ~ "'" }
seconds     = ${ absolute ~ "\"" }
fractional  = ${ "d" ~ absolute }
integer     = @{ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }
float       = @{ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* ~ point ~ ASCII_DIGIT+ ~ exponent? }
exponent    = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }
compound    =  { parens | braces | brackets | ratio }
parens      =  { "(" ~ exps ~ ")" }
braces      =  { "{" ~ exps ~ "}" }
brackets    =  { "[" ~ exp ~ ("," ~ exp)* ~ "]" }
ratio       = ${ integer ~ (":" ~ integer)+ }
pure        =  { relative | absolute }
relative    = ${ sign ~ absolute }
sign        =  { plus | minus }
absolute    =  { float | integer }
primitive   =  { prefix | suffix }
prefix      =  { dur | pc | reg | rest }
suffix      =  { amp | bpm | freq }
op          = ${ (colon | intercalate)+ }
freq        =  { "~" }
colon       =  { ":" }
intercalate =  { "><" }
bpm         =  { "bpm" }
pc          =  { "pc" }
reg         =  { "reg" }
dur         =  { "d" }
rest        =  { "r" }
amp         =  { "A" }
prime       =  { "`" }
plus        =  { "+" }
minus       =  { "-" }
point       =  { "." }
WHITESPACE  = _{ " " | "\t" | "\r" | "\n" }
// COMMENT           =  { "--" ~ (!("\n") ~ ANY)* }
